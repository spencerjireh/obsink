{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ObSink",
  "version": "0.3.0",
  "identifier": "com.obsink.desktop",
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "publisher": "Spencer Jireh Cebrian",
    "copyright": "Copyright 2026 Spencer Jireh Cebrian. MIT license.",
    "category": "Productivity",
    "shortDescription": "End-to-end encrypted Obsidian vault sync.",
    "longDescription": "ObSink keeps an Obsidian vault the same on every device through a server that only ever stores encrypted files. The key is derived from a passphrase and never leaves your devices.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "signingIdentity": null
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "popover",
        "title": "ObSink",
        "width": 360,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "minimizable": false,
        "maximizable": false,
        "closable": false,
        "acceptFirstMouse": true,
        "shadow": true
      },
      {
        "label": "settings",
        "title": "ObSink settings",
        "width": 900,
        "height": 620,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  }
}
