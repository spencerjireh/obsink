name = "obsink-worker"
main = "src/index.ts"
compatibility_date = "2026-04-14"

[[kv_namespaces]]
binding = "META"
id = "replace-with-kv-namespace-id"

[[r2_buckets]]
binding = "FILES"
bucket_name = "replace-with-r2-bucket-name"

[vars]
MAX_BATCH_INLINE_BYTES = 52428800
# Accounts (hosted mode). Secrets set separately: API_KEY (operator bearer,
# optional on hosted), RESEND_API_KEY (email sign-in).
APPLE_CLIENT_IDS = ""            # e.g. "com.obsink.ios"; empty disables Sign in with Apple
MAIL_FROM = "ObSink <onboarding@resend.dev>"
MAX_VAULTS_PER_USER = "10"
MAX_VAULT_BYTES = "1073741824"

[triggers]
crons = ["0 3 * * *", "30 3 * * *"]
