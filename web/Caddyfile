# The website container on obsink.spencerjireh.com. Traefik (Coolify)
# terminates TLS and forwards plain HTTP here; the `server` container is the
# API on obsink-api.spencerjireh.com, which this host also proxies so builds
# that bake the old host keep working and the browser client stays same-origin.
#
#   /auth/*, /vaults, /vaults/*, /healthz  ->  server:8080
#   /                             ->  server:8080 for API clients (Accept: */*),
#                                     the landing page for browsers (text/html);
#                                     Vary: Accept keeps the two apart in caches
#   /app/*                        ->  the browser client (SPA); hashed assets are
#                                     immutable, index.html is always revalidated,
#                                     a missing asset is a 404, not the index
#   /install.sh, everything else  ->  the static site
#
# No request-body limit and no proxy timeouts: batch uploads are up to
# 128 MiB and may take minutes.
{
	auto_https off
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "frame-ancestors 'none'"
		defer
	}

	@api path /auth/* /vaults /vaults/* /healthz
	handle @api {
		reverse_proxy server:8080 {
			flush_interval -1
		}
	}

	# Native clients and the browser client probe GET / for the sign-in
	# methods; browsers navigating ask for HTML.
	@probe {
		path /
		not header Accept *text/html*
	}
	handle @probe {
		header {
			Vary Accept
			Cache-Control no-store
			defer
		}
		reverse_proxy server:8080
	}

	redir /favicon.ico /icon.svg 301
	redir /app /app/ 301

	handle_path /app/* {
		root * /srv/app
		@asset path /assets/*
		handle @asset {
			header Cache-Control "public, max-age=31536000, immutable"
			header /assets/*.wasm Content-Type application/wasm
			file_server
		}
		handle {
			header Cache-Control no-cache
			try_files {path} /index.html
			file_server
		}
	}

	handle {
		root * /srv/site
		@landing path / /index.html
		header @landing Vary Accept
		@revalidate path / /index.html /install.sh
		header @revalidate Cache-Control no-cache
		file_server
	}

	handle_errors {
		header Content-Type "text/html; charset=utf-8"
		respond `<!doctype html><html lang="en"><meta charset="utf-8"><title>ObSink</title><p>{err.status_code} {err.status_text}. <a href="/">Back to ObSink</a>.</p></html>` {err.status_code}
	}
}
