/target/
# wasm-pack output of core-wasm (rebuilt by CI and the web image)
/core-wasm/pkg/
/desktop/node_modules/
/desktop/dist/
/desktop/src-tauri/gen/

# Server data dir when running the binary outside Docker
/server/data/

# Secrets / local env (never commit)
.env
.env.*
!.env.example

# macOS
.DS_Store

# iOS build artifacts (regenerate with scripts/build-ios.sh)
/ios/Generated/
/ios/Frameworks/
/ios/ObSink.xcodeproj/
/ios/build/
/ios/DerivedData/
/ios/headers/

# lefthook per-clone overrides
lefthook-local.yml

# `tauri icon` mobile output; scripts/gen-icons.sh keeps only the macOS set
/desktop/src-tauri/icons/android/
/desktop/src-tauri/icons/ios/
