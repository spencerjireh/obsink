# ObSink deployment and harness credentials. Copy to .env.deploy (gitignored)
# and fill in. Source it before the CLI or the scripts/verify-* harnesses:
#   set -a; . ./.env.deploy; set +a
#
# docker compose never reads this file (it only picks up a file named .env,
# which this repo does not use), so the local stack always starts with its
# own defaults: dev-operator-key and Mailpit.

# The server. Unset, the CLI, the desktop app and the iOS app fall back to the
# public API host (https://obsink-api.spencerjireh.com); the desktop and iOS
# builds bake whatever is set here at build time (scripts/build-ios.sh,
# `npm run tauri build`), the CLI reads it per command and can also bake it.
export OBSINK_SERVER_URL=http://localhost:8080
# Operator bearer. The same value is passed to the server as OBSINK_API_KEY.
export OBSINK_API_KEY=change-me

# Apple team ID for iOS code signing (XcodeGen substitutes it into the
# generated project; see scripts/build-ios.sh).
export DEVELOPMENT_TEAM=

# App Store Connect API key for scripts/release-ios.sh and scripts/testflight.py.
export ASC_KEY_ID=
export ASC_ISSUER_ID=
export ASC_KEY_PATH=

# Release signing runs in GitHub Actions (release.yml), not from this file.
# A fork that cuts releases needs these repository secrets (gh secret set):
#   APPLE_CERTIFICATE           base64 of the Developer ID Application .p12
#   APPLE_CERTIFICATE_PASSWORD  its password
#   APPLE_SIGNING_IDENTITY      "Developer ID Application: <name> (<team id>)"
#   APPLE_API_KEY               App Store Connect API key id (notarization)
#   APPLE_API_ISSUER            its issuer id
#   APPLE_API_KEY_P8            the .p8 file contents
# scripts/ci-import-signing-cert.sh shows how the certificate is used.
