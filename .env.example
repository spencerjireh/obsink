# ObSink local credentials. Copy to .env (gitignored) and fill in.
# Source it before the CLI or the scripts/verify-* harnesses:
#   set -a; . ./.env; set +a

# Self-hosted server reached by the CLI and the verify scripts. The desktop
# and iOS builds bake it in as their only server (scripts/build-ios.sh,
# `npm run tauri build`); leave it unset to build against the public server.
export OBSINK_SERVER_URL=http://localhost:8080
# Operator bearer. The same value is passed to the server as OBSINK_API_KEY.
export OBSINK_API_KEY=change-me

# Apple team ID for iOS code signing (XcodeGen substitutes it into the
# generated project; see scripts/build-ios.sh).
export DEVELOPMENT_TEAM=

# App Store Connect API key for scripts/release-ios.sh and scripts/testflight.py.
export ASC_KEY_ID=
export ASC_ISSUER_ID=
export ASC_KEY_PATH=
